{
  "name": "jira-dc-mock-server",
  "version": "0.1.0",
  "private": true,
  "description": "A stateful mock of the Jira Data Center 10.3 REST API for local agent development",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "contracts:test": "tsx --test test/official-contract.test.ts test/official-response-contract.test.ts",
    "contracts:update": "node scripts/download-jira-openapi.mjs",
    "manifest:update": "tsx scripts/generate-endpoint-manifest.ts",
    "start": "node dist/src/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.1",
    "ajv": "^8.20.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
